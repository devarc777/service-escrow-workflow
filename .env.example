# App
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/service_escrow?schema=public

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Stripe (test keys only)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Auto-accept SUBMITTED work orders after N days
WORK_ORDER_AUTO_COMPLETE_DAYS=7

# Optional email (notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
RESEND_API_KEY=
